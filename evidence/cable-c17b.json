 "definitions": "def adjC (a b : Fin 17) : Bool :=\n  (a - b = 1) || (a - b = 2) || (a - b = 4) || (a - b = 8) ||\n  (a - b = 9) || (a - b = 13) || (a - b = 15) || (a - b = 16)\n\ndef colC (a b : Fin 17) : Bool :=\n  (a - b = 1) || (a - b = 4) || (a - b = 13) || (a - b = 16)",
 "hypotheses": [],
 "conclusion": "∀ a b c : Fin 17, (adjC a b && adjC a c && adjC b c && (colC a b == colC a c) && (colC a c == colC b c)) = false",
